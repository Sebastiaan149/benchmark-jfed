# Fixed addresses from rspec/wall1-four-pcgen07-1p-ubuntu24.rspec.
: "${SSH_USER:=$(id -un)}"
: "${SERVER_NAME:=server0}"
: "${SERVER_IP:=10.0.1.2}"
: "${SERVER_SSH:=$SSH_USER@10.0.1.2}"

: "${CONTROLLER_NAME:=client0}"
: "${CONTROLLER_IP:=10.0.1.11}"
: "${CLIENT_NAMES:=client0 client1 client2}"
: "${CLIENT_IPS:=10.0.1.11 10.0.1.12 10.0.1.13}"
: "${CLIENT_SSHS:=$SSH_USER@10.0.1.12 $SSH_USER@10.0.1.13}"

: "${WORKSPACE_ROOT:=/local/masterproef_repos}"
: "${BENCHMARK_DIR:=/local/masterproef_repos/benchmark-jfed}"
: "${REMOTE_WORKSPACE:=/local/masterproef_repos}"
: "${REMOTE_BENCHMARK_DIR:=/local/masterproef_repos/benchmark-jfed}"
: "${REMOTE_CLIENT_WORKSPACE:=/local/masterproef_repos}"
: "${REMOTE_CLIENT_BENCHMARK_DIR:=/local/masterproef_repos/benchmark-jfed}"

: "${TOTAL_CLIENTS:=64}"
: "${CLIENT_NODE_CAPACITIES:=22 21 21}"
: "${MAX_CLIENTS_PER_NODE:=22}"
: "${NETNS_PREFIX:=bench-c}"
: "${CLIENT_SUBNET_PREFIX:=10.200}"
: "${CLIENT_RATE:=20mbit}"
: "${NAMESPACE_LATENCY_MS:=0}"

: "${CLIENT_CPU_MAX:=15000 100000}"
: "${CLIENT_MEMORY_MAX:=896M}"
