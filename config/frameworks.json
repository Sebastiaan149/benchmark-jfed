{
  "sizes": {
    "1m": { "scale": "10", "expectedTriples": 1000000 },
    "10m": { "scale": "100", "expectedTriples": 10000000 },
    "50m": { "scale": "500", "expectedTriples": 50000000 },
    "100m": { "scale": "1000", "expectedTriples": 100000000 }
  },
  "concurrency": [1, 2, 4, 8, 16, 32, 64],
  "defaultIterations": 1,
  "queryCount": 1,
  "queryRecurrence": 1,
  "defaultQuerySelection": "five",
  "querySelections": {
    "c3": [
      { "template": "C3", "instance": 1 }
    ],
    "hundred": {
      "allTemplates": true,
      "repetitions": 5
    },
    "twenty": [
      { "template": "C1", "instance": 1 },
      { "template": "C2", "instance": 1 },
      { "template": "C3", "instance": 1 },
      { "template": "F1", "instance": 1 },
      { "template": "F2", "instance": 1 },
      { "template": "F3", "instance": 1 },
      { "template": "F4", "instance": 1 },
      { "template": "F5", "instance": 1 },
      { "template": "L1", "instance": 1 },
      { "template": "L2", "instance": 1 },
      { "template": "L3", "instance": 1 },
      { "template": "L4", "instance": 1 },
      { "template": "L5", "instance": 1 },
      { "template": "S1", "instance": 1 },
      { "template": "S2", "instance": 1 },
      { "template": "S3", "instance": 1 },
      { "template": "S4", "instance": 1 },
      { "template": "S5", "instance": 1 },
      { "template": "S6", "instance": 1 },
      { "template": "S7", "instance": 1 }
    ],
    "five": [
      { "template": "C1", "instance": 1 },
      { "template": "F1", "instance": 1 },
      { "template": "L1", "instance": 1 },
      { "template": "S1", "instance": 1 },
      { "template": "S7", "instance": 1 }
    ],
    "ten": [
      { "template": "C1", "instance": 1 },
      { "template": "C2", "instance": 1 },
      { "template": "F1", "instance": 1 },
      { "template": "F2", "instance": 1 },
      { "template": "L1", "instance": 1 },
      { "template": "L2", "instance": 1 },
      { "template": "S1", "instance": 1 },
      { "template": "S2", "instance": 1 },
      { "template": "S6", "instance": 1 },
      { "template": "S7", "instance": 1 }
    ]
  },
  "resources": {
    "workers": 6,
    "javaXms": "8g",
    "javaXmx": "56g",
    "clientNodeMaxOldSpaceSizeMb": 1536,
    "serverNodeMaxOldSpaceSizeMb": 57344,
    "queryTimeoutSeconds": 1800,
    "sampleIntervalMs": 1000,
    "retainQueryOutputs": false,
    "keepClientCaches": false
  },
  "frameworks": {
    "smartkg": {
      "port": 18080,
      "server": "original-smartkg-server",
      "engine": "query-sparql-smartkg",
      "source": "http://localhost:{port}/smartkg",
      "cacheModes": ["cold", "warm"],
      "requires": ["dataset.hdt", "partitioning/metadata.json", "partitioning/hdt"]
    },
    "smartkg-cache": {
      "port": 18180, "server": "nginx-fragment-cache", "cacheOriginFramework": "smartkg",
      "engine": "query-sparql-smartkg", "source": "http://localhost:{port}/smartkg",
      "cacheModes": ["cold"], "requires": ["dataset.hdt", "partitioning/metadata.json", "partitioning/hdt"]
    },
    "smartkg-plus": {
      "port": 18081,
      "server": "smartkg_plus_server",
      "engine": "query-sparql-smartkg",
      "source": "smartkg+@http://localhost:{port}/smartkg+",
      "cacheModes": ["cold", "warm"],
      "requires": ["dataset.hdt", "dataset.hdt.cs", "typed-partitioning/metadata.json", "typed-partitioning/hdt"]
    },
    "smartkg-plus-cache": {
      "port": 18181, "server": "nginx-fragment-cache", "cacheOriginFramework": "smartkg-plus",
      "engine": "query-sparql-smartkg", "source": "smartkg+@http://localhost:{port}/smartkg+",
      "cacheModes": ["cold"], "requires": ["dataset.hdt", "dataset.hdt.cs", "typed-partitioning/metadata.json", "typed-partitioning/hdt"]
    },
    "wisekg": {
      "port": 18082,
      "server": "wisekg-server",
      "engine": "query-sparql-wisekg",
      "source": "wisekg@http://localhost:{port}/wisekg",
      "cacheModes": ["cold", "warm"],
      "queryTimeoutSeconds": 1800,
      "requires": ["dataset.hdt", "dataset.hdt.cs", "partitioning/metadata.json", "partitioning/hdt"]
    },
    "wisekg-cache": {
      "port": 18182, "server": "nginx-fragment-cache", "cacheOriginFramework": "wisekg",
      "engine": "query-sparql-wisekg", "source": "wisekg@http://localhost:{port}/wisekg",
      "cacheModes": ["cold"], "queryTimeoutSeconds": 1800,
      "requires": ["dataset.hdt", "dataset.hdt.cs", "partitioning/metadata.json", "partitioning/hdt"]
    },
    "passage": {
      "port": 18083,
      "server": "passage-server",
      "engine": "query-passage",
      "source": "passage@http://localhost:{port}/data/passage",
      "healthPath": "/$/ping",
      "cacheModes": ["cold"],
      "requires": ["passage/local-data.properties", "passage/dataset.jnl"]
    },
    "passage-cache": {
      "port": 18183, "server": "nginx-fragment-cache", "cacheOriginFramework": "passage",
      "engine": "query-passage", "source": "passage@http://localhost:{port}/data/passage",
      "healthPath": "/$/ping", "cacheModes": ["cold"],
      "requires": ["passage/local-data.properties", "passage/dataset.jnl"]
    },
    "spf": {
      "port": 18084,
      "server": "spf-server",
      "engine": "query-sparql-spf",
      "source": "spf@http://localhost:{port}/spf",
      "cacheModes": ["cold"],
      "queryTimeoutSeconds": 1800,
      "requires": ["dataset.hdt"]
    },
    "spf-cache": {
      "port": 18184, "server": "nginx-fragment-cache", "cacheOriginFramework": "spf",
      "engine": "query-sparql-spf", "source": "spf@http://localhost:{port}/spf",
      "cacheModes": ["cold"], "queryTimeoutSeconds": 1800, "requires": ["dataset.hdt"]
    },
    "ldf-endpoint": {
      "port": 18085,
      "server": "comunica-file-http",
      "workers": 1,
      "engine": "query-sparql",
      "source": "http://localhost:{port}/sparql",
      "cacheModes": ["cold"],
      "requires": ["dataset.nt"]
    },
    "ldf-endpoint-cache": {
      "port": 18185, "server": "nginx-fragment-cache", "cacheOriginFramework": "ldf-endpoint",
      "engine": "query-sparql", "source": "http://localhost:{port}/sparql",
      "cacheModes": ["cold"], "requires": ["dataset.nt"]
    },
    "ldf-tpf": {
      "port": 18086,
      "server": "server-js-tpf",
      "engine": "query-sparql",
      "source": "http://localhost:{port}/watdiv",
      "cacheModes": ["cold"],
      "requires": ["dataset.hdt"]
    },
    "ldf-tpf-cache": {
      "port": 18088,
      "server": "nginx-fragment-cache",
      "cacheOriginFramework": "ldf-tpf",
      "engine": "query-sparql",
      "source": "http://localhost:{port}/watdiv",
      "cacheModes": ["cold"],
      "requires": ["dataset.hdt"]
    },
    "ldf-qpf": {
      "port": 18087,
      "server": "server-js-qpf",
      "engine": "query-sparql",
      "source": "http://localhost:{port}/watdiv",
      "cacheModes": ["cold"],
      "requires": ["dataset.hdt"]
    },
    "ldf-qpf-cache": {
      "port": 18187, "server": "nginx-fragment-cache", "cacheOriginFramework": "ldf-qpf",
      "engine": "query-sparql", "source": "http://localhost:{port}/watdiv",
      "cacheModes": ["cold"], "requires": ["dataset.hdt"]
    },
    "ldf-dump-hdt": {
      "port": 18089,
      "server": "static-hdt-dump",
      "engine": "query-sparql-hdt",
      "clientMode": "hdt-download",
      "source": "http://localhost:{port}/hdt/dataset.hdt",
      "cacheModes": ["cold"],
      "queryTimeoutSeconds": 1800,
      "requires": ["dataset.hdt", "dataset.hdt.index.v1-1"]
    },
    "ldf-brtpf": {
      "port": 18090,
      "server": "spf-server",
      "engine": "query-sparql",
      "source": "brtpf@http://localhost:{port}/spf",
      "cacheModes": ["cold"],
      "requires": ["dataset.hdt"]
    },
    "ldf-brtpf-cache": {
      "port": 18190, "server": "nginx-fragment-cache", "cacheOriginFramework": "ldf-brtpf",
      "engine": "query-sparql", "source": "brtpf@http://localhost:{port}/spf",
      "cacheModes": ["cold"], "requires": ["dataset.hdt"]
    }
  }
}
